# ==============================================================================
# SAAS PRO POS & INVENTORY ENTERPRISE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your root project directory:
#      cp .env.example .env
# 2. Update credentials below according to your local / production server.
# 3. Keep '.env' secure and never commit it to public version control repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION GENERAL CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="SaaS Pro POS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:YOUR_RANDOM_32_CHAR_BASE64_KEY_HERE
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas-pro-pos
DB_USERNAME=root
DB_PASSWORD=""

# Legacy Aliases (Supported for full backward compatibility)
DB_NAME=saas-pro-pos
DB_USER=root
DB_PASS=""

# ------------------------------------------------------------------------------
# SESSION & COOKIE SETTINGS
# ------------------------------------------------------------------------------
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_COOKIE_NAME=saas_pos_session

# ------------------------------------------------------------------------------
# MAIL / SMTP SERVER CONFIGURATION (INVOICES & NOTIFICATIONS)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# HARDWARE & POS TERMINAL PREFERENCES
# ------------------------------------------------------------------------------
# Barcode input mode: scanner (auto-detects hardware laser) or manual
POS_BARCODE_MODE=scanner
# Default unit for weighted bulk products: kg, g, pcs
POS_WEIGHT_UNIT=kg
# Default tax rate applied to invoices (percentage, e.g. 0 or 5 or 16)
POS_DEFAULT_TAX_RATE=0
# Fiscal / Tax authority integration (FBR Pakistan or similar)
FBR_POS_ENABLED=false
FBR_POS_ID=""

# ------------------------------------------------------------------------------
# WHATSAPP & SMS RECEIPT GATEWAY (OPTIONAL)
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=""
SMS_GATEWAY_PROVIDER=none
SMS_API_KEY=""
