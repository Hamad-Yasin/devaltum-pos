{
  "appId": "com.devaltumpoc.scanner",
  "appName": "DevAltum POS Scanner",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": true,
    "allowNavigation": ["*"],
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "CapacitorCookies": {
      "enabled": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0f6dff"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#ffffff"
    }
  }
}
